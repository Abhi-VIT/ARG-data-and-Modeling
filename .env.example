# Generate your own SECRET_KEY. This file contains no usable secret.
SECRET_KEY=
DEBUG=True
DATABASE_URL=postgres://arg:arg_local@127.0.0.1:5432/arg
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
# Private data directory; never expose it using a public media URL.
MEDIA_ROOT=media
MAX_UPLOAD_MB=200
MAX_ROWS=1000000
MAX_COLUMNS=500
# Used by server-to-server fetch. Comma-separated exact public hostnames.
IMPORT_URL_HOSTS=docs.google.com
